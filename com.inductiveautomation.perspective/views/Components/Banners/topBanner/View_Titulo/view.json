{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 50
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Image"
            },
            "position": {
              "basis": "140px"
            },
            "props": {
              "fit": {
                "mode": "contain"
              },
              "source": "/system/images/Daltile/GrupoDaltile.jpg"
            },
            "type": "ia.display.image"
          }
        ],
        "meta": {
          "name": "FlexContainer_0"
        },
        "position": {
          "basis": "200px"
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "FlexContainer_1"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "props": {
              "path": "material/person_outline"
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Label_0"
            },
            "position": {
              "basis": "150px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "session.props.auth.user.userName"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "marginLeft": "10px",
                "marginRight": "10px"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "200px",
          "shrink": 0
        },
        "props": {
          "justify": "space-between",
          "style": {
            "marginRight": "10px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {},
              "scope": "C",
              "type": "logout"
            }
          }
        },
        "meta": {
          "name": "Button"
        },
        "props": {
          "style": {
            "backgroundColor": "#FFFFFF00",
            "borderColor": "#000000",
            "borderStyle": "solid",
            "borderWidth": 1
          },
          "text": "Cerrar sesión",
          "textStyle": {
            "color": "#000000",
            "fontFamily": "Roboto",
            "fontSize": 15,
            "fontWeight": "bold",
            "margin": 5
          }
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "borderBottomColor": "#D5D5D5",
        "borderBottomStyle": "solid",
        "borderBottomWidth": 1,
        "overflow": "hidden",
        "padding": "10px"
      }
    },
    "type": "ia.container.flex"
  }
}