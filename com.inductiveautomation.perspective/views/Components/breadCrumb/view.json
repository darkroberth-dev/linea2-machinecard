{
  "custom": {},
  "params": {
    "home": true,
    "pageName": "Recetas",
    "pagePath": ""
  },
  "propConfig": {
    "params.home": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.pageName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.pagePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": ""
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "30px"
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "path": "view.params.home"
                  },
                  "transforms": [
                    {
                      "code": "\tif value \u003d\u003d True:\n\t\treturn \"material/home\"\n\telse:\n\t\treturn \"material/arrow_forward_ios\"",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "#0C7BB3"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "FlexContainer_1"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "props": {
          "style": {
            "marginLeft": 5,
            "marginRight": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(self.view.params.pagePath)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Label"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.pageName"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "breadcrumb",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignContent": "flex-start",
      "alignItems": "center"
    },
    "type": "ia.container.flex"
  }
}