{
  "custom": {
    "options": []
  },
  "params": {
    "database": "",
    "machineId": "",
    "machineTitle": "",
    "selectedKeys": [],
    "udtPath": ""
  },
  "propConfig": {
    "params.database": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.machineId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.machineTitle": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selectedKeys": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.udtPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 560,
      "width": 440
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex",
    "props": {
      "direction": "column",
      "style": {
        "height": "100%",
        "padding": "16px",
        "width": "100%"
      }
    },
    "events": {
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tselected = set(self.view.params.selectedKeys or [])\n\trows = []\n\tfor row in metrics.service.options():\n\t\titem = dict(row)\n\t\titem['selected'] = item.get('key') in selected\n\t\trows.append(item)\n\tself.view.custom.options = rows\n"
          }
        }
      }
    },
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "type": "ia.display.label",
        "props": {
          "text": "Metricas visibles",
          "style": {
            "fontSize": "18px",
            "fontWeight": "700"
          }
        }
      },
      {
        "meta": {
          "name": "Hint"
        },
        "type": "ia.display.label",
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.machineTitle"
              }
            }
          }
        },
        "props": {
          "text": "",
          "style": {
            "color": "#6d7782",
            "fontSize": "13px",
            "marginBottom": "12px",
            "marginTop": "4px"
          }
        }
      },
      {
        "meta": {
          "name": "Options"
        },
        "type": "ia.display.flex-repeater",
        "position": {
          "grow": 1,
          "basis": "0px"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.options"
              }
            }
          }
        },
        "props": {
          "path": "Components/Cards/MetricOption",
          "direction": "column",
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false,
          "elementPosition": {
            "basis": "36px",
            "grow": 0,
            "shrink": 0
          },
          "style": {
            "overflow": "auto",
            "width": "100%"
          }
        }
      },
      {
        "meta": {
          "name": "Buttons"
        },
        "type": "ia.container.flex",
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "justify": "flex-end",
          "alignItems": "center",
          "style": {
            "marginTop": "12px"
          }
        },
        "children": [
          {
            "meta": {
              "name": "Cancel"
            },
            "type": "ia.input.button",
            "props": {
              "text": "Cancelar",
              "style": {
                "marginRight": "8px"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.perspective.closePopup('metricSelector')\n"
                  }
                }
              }
            }
          },
          {
            "meta": {
              "name": "Apply"
            },
            "type": "ia.input.button",
            "props": {
              "text": "Aplicar",
              "primary": true
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tselected = []\n\tfor row in self.parent.getChild('Options').props.instances:\n\t\tif row.get('selected'):\n\t\t\tselected.append(row.get('key'))\n\tcontext = {\n\t\t'machineId': self.view.params.machineId,\n\t\t'udtPath': self.view.params.udtPath,\n\t\t'database': self.view.params.database,\n\t\t'title': self.view.params.machineTitle,\n\t}\n\tmetrics.service.apply_selection(self.page, self.view.params.machineTitle, selected, context)\n\tsystem.perspective.closePopup('metricSelector')\n"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}